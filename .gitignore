# Dependencies
node_modules/
vendor/

# Build artifacts (generated)
# `build/pwa/` IS tracked: the gd-wordpress-deployer rsync reflects the
# working tree, so the production-shaped staging tests need the bundle on
# disk. Mirrors the courtneyr-child theme pattern of committing built CSS.
# `npm run build` is part of the deploy ritual — see docs/STAGING-DEPLOY.md.
#
# Pattern: ignore the contents of build/ (build/*) rather than the
# directory itself (build/), so the !build/pwa/ exception can re-include
# the PWA bundle. Excluding a directory entry blocks all re-inclusion of
# its children — gitignore won't recurse into an ignored directory.
build/*
!build/pwa/
# G3.5c — @wordpress/scripts emits the Gutenberg sidebar bundle here.
# Committed for the same staging-deploy reasons as build/pwa/.
!build/index.js
!build/index.asset.php
!build/index.css
!build/style-index.css
!build/index.css.map
!build/index.js.map
dist/
pwa/dist/
# Anchor .vite/ to the project root so Vite's dev server cache stays
# ignored, but the production manifest at build/pwa/.vite/manifest.json
# (which the PHP shell reads to look up cache-busted asset URLs) is tracked.
/.vite/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.buildpath

# Testing
coverage/
.phpunit.result.cache
.phpunit.cache
test-results/
playwright-report/
playwright/.cache/

# Deployment artifacts
*.zip
test-dist/
dist-test/
wordpress-org-upload/
WORDPRESS-ORG-UPLOAD-README.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets — never commit these
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
credentials.json

# Site-specific values that must not leak into the public repo
staging-url.txt
production-url.txt
.outpost-site-config.json

# Temporary files
tmp/
temp/
*.xml
!phpunit.xml.dist
blueprint-local.json
PLAYGROUND-URL.txt

# Package manager locks — tracked for reproducible builds
# (uncomment to exclude)
# package-lock.json
# composer.lock

# WordPress core (defensive — Outpost is a sibling repo, not a WP install,
# but this prevents accidental commits if dragged into one)
wp-content/
wp-admin/
wp-includes/

# Note: .wordpress-org/ is tracked in git for version control
# but excluded from plugin ZIP via .distignore
.gstack/

# Phase G overnight run working files (per docs/dev/prompts/G-overnight-runbook.md §5).
# Both files are ephemeral status logs for Courtney's morning review; never committed.
.overnight-progress.md
.overnight-questions.md
