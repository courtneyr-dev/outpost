{
	"request": {
		"method": "POST",
		"url": "/v1/oauth/token/refresh"
	},
	"response": {
		"status": 200,
		"headers": { "Content-Type": "application/json" },
		"jsonBody": {
			"access_token": "fixture-refreshed-access-token",
			"refresh_token": "fixture-refreshed-refresh-token",
			"token_type": "Bearer",
			"expires_in": 3600
		}
	}
}
