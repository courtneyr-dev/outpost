{
	"request": {
		"method": "GET",
		"urlPath": "/oembed",
		"queryParameters": {
			"url": {
				"matches": ".*youtube.*v=SERVICE_DOWN.*"
			}
		}
	},
	"response": {
		"status": 503,
		"headers": {
			"Content-Type": "text/html; charset=utf-8"
		},
		"body": "<html>\n<head><title>503 Service Unavailable</title></head>\n<body>503 Service Unavailable</body>\n</html>"
	}
}
