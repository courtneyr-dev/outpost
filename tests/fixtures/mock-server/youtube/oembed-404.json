{
	"request": {
		"method": "GET",
		"urlPath": "/oembed",
		"queryParameters": {
			"url": {
				"matches": ".*youtube.*v=DELETED_VIDEO.*"
			}
		}
	},
	"response": {
		"status": 404,
		"headers": {
			"Content-Type": "application/json; charset=utf-8"
		},
		"jsonBody": {
			"error": "Not Found"
		}
	}
}
