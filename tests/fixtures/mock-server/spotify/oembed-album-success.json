{
	"request": {
		"method": "GET",
		"urlPath": "/oembed",
		"queryParameters": {
			"url": {
				"matches": ".*spotify.*\\/album\\/.*"
			}
		}
	},
	"response": {
		"status": 200,
		"headers": {
			"Content-Type": "application/json; charset=utf-8"
		},
		"jsonBody": {
			"version": "1.0",
			"type": "rich",
			"provider_name": "Spotify",
			"provider_url": "https://spotify.com",
			"title": "Sample Album Title",
			"thumbnail_url": "https://example.test/spotify-album-thumb.jpg",
			"thumbnail_width": 300,
			"thumbnail_height": 300,
			"html": "<iframe src=\"https://open.spotify.com/embed/album/1111111111111111111111\" width=\"456\" height=\"352\" allowtransparency=\"true\" allow=\"encrypted-media\" frameborder=\"0\"></iframe>",
			"width": 456,
			"height": 352
		}
	}
}
