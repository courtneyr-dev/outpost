{
  "name": "outpost",
  "version": "0.1.1",
  "description": "Mobile-first Progressive Web App composer for IndieWeb POSSE workflows.",
  "author": "Courtney Robertson <https://courtneyr.dev>",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/courtneyr-dev/outpost",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/courtneyr-dev/outpost.git"
  },
  "bugs": {
    "url": "https://github.com/courtneyr-dev/outpost/issues"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint pwa/src",
    "lint:fix": "eslint pwa/src --fix",
    "format": "prettier --write \"pwa/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"pwa/src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.13.0",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^15.0.0",
    "preact": "^10.24.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.10.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0",
    "workbox-window": "^7.3.0"
  },
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.0.0"
  }
}
