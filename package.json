{
  "name": "outpost",
  "version": "1.0.0",
  "files": [
    "admin",
    "assets",
    "build",
    "includes",
    "styles",
    "languages",
    "outpost.php",
    "uninstall.php",
    "readme.txt",
    "LICENSE",
    "!**/.gitkeep",
    "!build/pwa/**/*.map"
  ],
  "description": "Mobile-first Progressive Web App composer for IndieWeb POSSE workflows.",
  "author": "Courtney Robertson <https://courtneyr.dev>",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/courtneyr-dev/outpost",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/courtneyr-dev/outpost.git"
  },
  "bugs": {
    "url": "https://github.com/courtneyr-dev/outpost/issues"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "node bin/check-tokens-parity.mjs && vite build",
    "check:tokens": "node bin/check-tokens-parity.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint pwa/src",
    "lint:fix": "eslint pwa/src --fix",
    "format": "prettier --write \"pwa/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"pwa/src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "wp-env": "wp-env",
    "wp-env:start": "wp-env start",
    "wp-env:stop": "wp-env stop",
    "wp-env:clean": "wp-env clean all",
    "wp-env:logs": "wp-env logs",
    "test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/outpost composer test:integration",
    "build:wp": "wp-scripts build",
    "build:all": "npm run build:wp && npm run build",
    "plugin-zip": "node bin/check-dist-paths.mjs && wp-scripts plugin-zip",
    "start:wp": "wp-scripts start",
    "lint:wp": "wp-scripts lint-js src",
    "format:wp": "wp-scripts format src",
    "test:wp:unit": "wp-scripts test-unit-js",
    "screenshots:docs": "node scripts/capture-docs-screenshots.cjs",
    "check:dist": "node bin/check-dist-paths.mjs",
    "package:wporg": "node bin/package-wporg.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@preact/preset-vite": "^2.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@wordpress/components": "^29.6.0",
    "@wordpress/data": "^10.21.0",
    "@wordpress/edit-post": "^8.45.0",
    "@wordpress/element": "^6.21.0",
    "@wordpress/env": "^11.5.0",
    "@wordpress/i18n": "^6.26.0",
    "@wordpress/icons": "^10.21.0",
    "@wordpress/plugins": "^7.45.0",
    "@wordpress/scripts": "^32.1.0",
    "ajv": "^8.20.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.11.13",
    "preact": "^10.24.0",
    "prettier": "^3.3.0",
    "prop-for-that": "0.7.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.3.0"
  },
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.0.0"
  },
  "jest": {
    "preset": "@wordpress/jest-preset-default",
    "roots": [
      "<rootDir>/src"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/build/",
      "/vendor/",
      "/pwa/"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.[jt]s?(x)",
      "<rootDir>/src/**/?(*.)test.[jt]s?(x)"
    ],
    "transform": {
      "\\.[jt]sx?$": "<rootDir>/node_modules/@wordpress/scripts/config/babel-transform.js"
    }
  }
}
